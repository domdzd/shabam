<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy-first: nothing goes to Google cloud backup. History moves between phones only through
     the optional NanoTune account. Secrets are also excluded from device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/credentials.preferences_pb" />
        <exclude domain="sharedpref" path="install.xml" />
        <exclude domain="file" path="clips/" />
    </device-transfer>
</data-extraction-rules>
