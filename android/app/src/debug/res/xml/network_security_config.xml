<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds may also reach a local, plain-http test server (e.g. http://10.0.2.2:8000 from
     the emulator or http://192.168.x.x:8000 on your LAN). Never ship this in release builds. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
