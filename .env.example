# NanoTune backend configuration. Copy to .env (git-ignored) and fill in. Placeholders only.

APP_ENV=production
APP_BASE_URL=https://api.example.com
SERVER_NAME=NanoTune
DATABASE_URL=sqlite:////data/nanotune.db

# --- Apple Media Services / ShazamKit token signing --------------------------------------
# Requires an Apple Developer Program membership (Certificates, Identifiers & Profiles):
#   1. Identifiers › + › Media IDs › enable ShazamKit (and MusicKit if wanted)
#   2. Keys › + › Media Services › choose the Media ID › download AuthKey_<KEY_ID>.p8 (once!)
# Put the .p8 file in deploy/secrets/apple_media_services.p8 (chmod 400). Never commit it.
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Informational only (not part of the JWT); handy when you rotate keys.
APPLE_MEDIA_ID=
APPLE_PRIVATE_KEY_PATH=/run/secrets/apple_media_services.p8
# Apple allows up to 15777000 s (6 months); short-lived tokens are safer. 60..15777000.
SHAZAMKIT_TOKEN_TTL_SECONDS=3600

# --- Optional accounts (history/favourites/settings sync) ---------------------------------
ACCOUNTS_ENABLED=true
REGISTRATION_OPEN=true
# >= 32 random characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# --- Rate limits (single API worker) -------------------------------------------------------
TOKEN_RATE_PER_INSTALL_PER_HOUR=60
TOKEN_RATE_PER_IP_PER_HOUR=600
LOGIN_RATE_PER_IP_PER_MINUTE=10
REGISTER_RATE_PER_IP_PER_HOUR=5

# --- Optional email: password reset and email verification codes (off without SMTP) -------
# Use your mail provider's SMTP submission server. Codes expire after 15 minutes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# e.g. NanoTune <no-reply@example.com>
SMTP_FROM=
# starttls (587), ssl (465) or none (local relay only)
SMTP_SECURITY=starttls
EMAIL_CODE_TTL_MINUTES=15
EMAIL_RATE_PER_ADDRESS_PER_HOUR=5
EMAIL_RATE_PER_IP_PER_HOUR=20

# --- Server-side recognition engines (all OFF by default) ---------------------------------
# Optional paid engines your server can call: as the main engine when the app has no ShazamKit,
# to retry saved recordings, or as an "enhanced" fallback after ShazamKit finds nothing.
# Each needs *_ENABLED=true, credentials AND a positive *_DAILY_LIMIT (hard cost cap per UTC day).
# The phone shows the disclosure and asks the user before any clip is uploaded.
RECOGNITION_KILL_SWITCH=false
PROVIDER_ORDER=audd,acrcloud
# fallback = stop at the first engine that matches; consensus = ask all and compare
ENHANCED_MODE=fallback
ENHANCED_MAX_UPLOAD_SECONDS=12
ENHANCED_PER_USER_DAILY_LIMIT=25
ENHANCED_PROVIDER_TIMEOUT_SECONDS=10

# Let phones WITHOUT an account use the engines (rate limited per install and per IP).
SERVER_RECOGNITION_ANONYMOUS=false
SERVER_RECOGNITION_PER_INSTALL_DAILY_LIMIT=10
SERVER_RECOGNITION_PER_IP_DAILY_LIMIT=50

# AudD — https://dashboard.audd.io (token). Paid service with a trial; check current pricing.
AUDD_ENABLED=false
AUDD_API_TOKEN=
AUDD_DAILY_LIMIT=0
AUDD_RETURN=apple_music,spotify

# ACRCloud — console.acrcloud.com › Audio & Video Recognition project (host, key, secret).
ACRCLOUD_ENABLED=false
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=
ACRCLOUD_DAILY_LIMIT=0
